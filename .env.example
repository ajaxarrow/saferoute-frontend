# URL of the Django API (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000
# Free key from https://cloud.maptiler.com/account/keys/ — powers the streets map and place search.
# It is public in the browser: restrict it to your domains (localhost:5173 + your Netlify URL) in the dashboard.
VITE_MAPTILER_KEY=
# Optional: override the map style URLs entirely
# VITE_MAP_STYLE_LIGHT=
# VITE_MAP_STYLE_DARK=
